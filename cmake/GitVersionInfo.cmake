# Generates GitVersionInfo.generated.h from Git history. This is a CMake port of
# Modules/Infra/Build/Scripts/GitVersionInfo.bat and is meant to be run in script mode:
#
#   cmake -DSRC_DIR=<repo> -DOUT_FILE=<header> [-DEXTRA=<build metadata>]
#         [-DFALLBACK_VERSION=<major.minor.patch>] -P GitVersionInfo.cmake
#
# The header is only rewritten when its content changes, so running this on every build does not
# cause needless recompilation.

if(NOT DEFINED SRC_DIR OR NOT DEFINED OUT_FILE)
  message(FATAL_ERROR "GitVersionInfo.cmake: SRC_DIR and OUT_FILE are required.")
endif()

set(version_major 0)
set(version_minor 0)
set(version_patch 0)
set(version_commit_distance 0)
set(version_is_dirty 0)
set(version_build_metadata "")
if(EXTRA)
  set(version_build_metadata "${EXTRA}.")
endif()

find_package(Git QUIET)
set(git_ok FALSE)
if(GIT_FOUND)
  execute_process(
    COMMAND "${GIT_EXECUTABLE}" rev-parse --is-inside-work-tree
    WORKING_DIRECTORY "${SRC_DIR}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(rc EQUAL 0 AND out STREQUAL "true")
    set(git_ok TRUE)
  endif()
endif()

if(git_ok)
  # Dirty if there are unstaged changes to tracked files (same test as the batch script).
  execute_process(
    COMMAND "${GIT_EXECUTABLE}" diff --shortstat
    WORKING_DIRECTORY "${SRC_DIR}"
    OUTPUT_VARIABLE diff_out ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(diff_out)
    set(version_is_dirty 1)
  endif()

  # Latest release tag (vMAJOR.MINOR.PATCH) merged into HEAD.
  execute_process(
    COMMAND "${GIT_EXECUTABLE}" tag --list "v[0-9]*.[0-9]*.[0-9]*" --merged HEAD --sort=version:refname
    WORKING_DIRECTORY "${SRC_DIR}"
    OUTPUT_VARIABLE tag_out ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
  set(release_tag "")
  if(tag_out)
    string(REPLACE "\n" ";" tag_list "${tag_out}")
    list(GET tag_list -1 release_tag)
  endif()

  if(release_tag AND release_tag MATCHES "^v([0-9]+)\\.([0-9]+)\\.([0-9]+)")
    set(version_major "${CMAKE_MATCH_1}")
    set(version_minor "${CMAKE_MATCH_2}")
    set(version_patch "${CMAKE_MATCH_3}")
    execute_process(
      COMMAND "${GIT_EXECUTABLE}" rev-list --count "${release_tag}..HEAD"
      WORKING_DIRECTORY "${SRC_DIR}"
      OUTPUT_VARIABLE version_commit_distance ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
  else()
    # No release tag: fall back to the configured base version and count from the first commit.
    if(FALLBACK_VERSION MATCHES "^([0-9]+)\\.([0-9]+)\\.([0-9]+)$")
      set(version_major "${CMAKE_MATCH_1}")
      set(version_minor "${CMAKE_MATCH_2}")
      set(version_patch "${CMAKE_MATCH_3}")
    endif()
    execute_process(
      COMMAND "${GIT_EXECUTABLE}" rev-list --count HEAD
      WORKING_DIRECTORY "${SRC_DIR}"
      OUTPUT_VARIABLE version_commit_distance ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
  endif()

  if(NOT version_commit_distance MATCHES "^[0-9]+$")
    set(version_commit_distance 0)
    set(version_build_metadata "unknown.${version_build_metadata}")
  endif()

  if(version_commit_distance EQUAL 0 AND version_is_dirty EQUAL 0)
    set(version_string "${version_major}.${version_minor}.${version_patch}")
  else()
    execute_process(
      COMMAND "${GIT_EXECUTABLE}" describe --abbrev=8 --always
      WORKING_DIRECTORY "${SRC_DIR}"
      OUTPUT_VARIABLE describe_out ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
    math(EXPR patch_plus_one "${version_patch} + 1")
    set(version_string
        "${version_major}.${version_minor}.${patch_plus_one}-dev.${version_commit_distance}.${version_is_dirty}")
    if(version_is_dirty EQUAL 0)
      set(version_build_metadata "${describe_out}.${version_build_metadata}")
    else()
      set(version_build_metadata "${describe_out}.dirty.${version_build_metadata}")
    endif()
  endif()
else()
  message(STATUS "Git not available; version information will be unknown.")
  if(FALLBACK_VERSION MATCHES "^([0-9]+)\\.([0-9]+)\\.([0-9]+)$")
    set(version_major "${CMAKE_MATCH_1}")
    set(version_minor "${CMAKE_MATCH_2}")
    set(version_patch "${CMAKE_MATCH_3}")
  endif()
  set(version_string "${version_major}.${version_minor}.${version_patch}")
  set(version_build_metadata "unknown.${version_build_metadata}")
endif()

if(version_build_metadata)
  string(REGEX REPLACE "\\.$" "" version_build_metadata "${version_build_metadata}")
  set(version_string "${version_string}+${version_build_metadata}")
endif()

math(EXPR version_flags "(${version_commit_distance} * 16) + (${version_is_dirty} * 1)")

set(content "// Git version information
// Auto-generated by GitVersionInfo.cmake
#define GIT_VERSION_MAJOR ${version_major}
#define GIT_VERSION_MINOR ${version_minor}
#define GIT_VERSION_PATCH ${version_patch}
#define GIT_VERSION_FLAGS ${version_flags}
#define GIT_VERSION_COMMIT_DISTANCE ${version_commit_distance}
#define GIT_VERSION_IS_DIRTY ${version_is_dirty}
#define GIT_VERSION_STRUCT ${version_major},${version_minor},${version_patch},${version_flags}
#define GIT_VERSION_STRING \"${version_string}\"
")

set(existing "")
if(EXISTS "${OUT_FILE}")
  file(READ "${OUT_FILE}" existing)
endif()
if(NOT existing STREQUAL content)
  get_filename_component(out_dir "${OUT_FILE}" DIRECTORY)
  file(MAKE_DIRECTORY "${out_dir}")
  file(WRITE "${OUT_FILE}" "${content}")
endif()
